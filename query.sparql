SELECT
  ?item
  (COALESCE(SAMPLE(?mulLabel), SAMPLE(?enLabel), MIN(?anyLabel), STRAFTER(STR(?item), "entity/")) AS ?itemLabel)
  ?prop
  ?value
  (SAMPLE(?anyFlag) AS ?flag)
  (SAMPLE(?anyLogo) AS ?logo)
WHERE {
  VALUES ?prop { wdt:P13786 wdt:P1282 }

  ?item ?prop ?value .

  # P18 isn't suitable for an icon, so it isn't included
  OPTIONAL { ?item wdt:P41  ?anyFlag }
  OPTIONAL { ?item wdt:P154 ?anyLogo }

  OPTIONAL { ?item rdfs:label ?mulLabel FILTER(LANG(?mulLabel) = "mul") }
  OPTIONAL { ?item rdfs:label ?enLabel  FILTER(LANG(?enLabel)  = "en") }
  OPTIONAL { ?item rdfs:label ?anyLabel }
}
GROUP BY ?item ?prop ?value
ORDER BY ?value ?item
